# Required in production
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# Explicit production access policy. Configure at least one.
# Until a durable session-owner ACL is added, production intentionally allows exactly one email.
AUTH_ALLOWED_EMAILS=developer@example.com
# AUTH_ALLOWED_DOMAINS must remain empty in this hardened build.
AUTH_ALLOWED_DOMAINS=

# Add custom production domains here (comma-separated, host only).
AUTH_ALLOWED_HOSTS=agent.example.com

# Optional: allow trusted Vercel-to-Vercel OIDC callers in addition to browser users.
ALLOW_VERCEL_OIDC=false

# Agent runtime
EVE_MODEL=openai/gpt-5.6-luna-fast
EVE_REASONING=medium
NEXT_PUBLIC_APP_NAME=sami

# Vercel Connect IDs. Leave blank to disable the corresponding connection.
# Example shape is provider/account-specific; create/link these through Vercel Connect.
VERCEL_MCP_CONNECT_ID=
GITHUB_MCP_CONNECT_ID=
