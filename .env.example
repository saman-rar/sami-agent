# Better Auth / Sign in with Vercel
BETTER_AUTH_SECRET=
VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# Recommended for a public deployment: only this Vercel account email may enter the shared workspace.
# If omitted, any successfully authenticated Vercel account can enter the single-owner workspace.
SAMI_OWNER_EMAIL=

# Private Vercel Blob persistence for the single-owner Sami workspace.
# Projects, chat/session index, provider settings/model selection, GitHub credentials,
# and agent permissions are shared across authenticated devices in this deployment.
BLOB_READ_WRITE_TOKEN=


# AES-256-GCM key material used to encrypt provider API keys and GitHub PATs at rest.
# Use a long random value (at least 32 characters) and keep it stable across deployments.
PROVIDER_SECRET_ENCRYPTION_KEY=

# Optional GitHub PAT fallback for a shared/single-owner deployment.
# Prefer Settings → GitHub when you want to replace/rotate it from the UI.
# Never commit a real token.
GITHUB_PAT=

# Optional provider/server configuration can be added here as needed.
