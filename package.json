{
  "name": "sami",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "next build",
    "deploy": "eve deploy",
    "dev": "next dev",
    "eval": "eve eval",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:eve": "eve build",
    "dev:eve": "eve dev",
    "start:eve": "eve start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "migrate:blob-to-postgres": "node --env-file-if-exists=.env.local --import tsx scripts/import-blob.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.56",
    "@ai-sdk/google": "4.0.75",
    "@ai-sdk/openai": "4.0.70",
    "@ai-sdk/openai-compatible": "3.0.52",
    "@ai-sdk/provider": "4.0.17",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@shikijs/core": "3.23.0",
    "@shikijs/engine-javascript": "3.23.0",
    "@shikijs/engine-oniguruma": "3.23.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.0",
    "@vercel/blob": "2.8.0",
    "@vercel/connect": "0.4.2",
    "ai": "7.0.105",
    "better-auth": "1.6.26",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "eve": "0.53.1",
    "lucide-react": "1.16.0",
    "motion": "12.40.0",
    "nanoid": "5.1.11",
    "next": "16.3.0",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shiki": "3.23.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "use-stick-to-bottom": "1.1.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "24.13.2",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@ai-sdk/provider": "4.0.17"
  }
}
